  <node
    class="Project">
    <node
      class="wxDialog"
      class_name="Blank"
      title="Current Test">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="dlg_sizer">
        <node
          class="wxStdDialogButtonSizer"
          flags="wxEXPAND" />
      </node>
    </node>
    <node
      class="wxDialog"
      class_name="Columnedit"
      style="wxDEFAULT_DIALOG_STYLE|wxCAPTION|wxSYSTEM_MENU"
      title="Test: nested group box, radio button group, extra column">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="dlg_sizer">
        <node
          class="wxFlexGridSizer">
          <node
            class="wxRadioButton"
            label=""
            var_comment="IDC_COL_TEXT_RADIO"
            var_name="m_radioBtn2" />
          <node
            class="wxStaticBoxSizer"
            label="Text to Insert"
            var_comment="IDC_COL_TEXT_GRP_STATIC"
            var_name="static_box2">
            <node
              class="wxTextCtrl"
              var_comment="IDC_COL_TEXT_EDIT"
              var_name="m_textCtrl2"
              minimum_size="97,-1d" />
          </node>
          <node
            class="wxRadioButton"
            label=""
            var_comment="IDC_COL_NUM_RADIO"
            var_name="m_radioBtn3" />
