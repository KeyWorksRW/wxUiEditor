<?xml version="1.0"?>
<wxUiEditorData
  data_version="16">
  <node
    class="Project"
    generate_languages="C++">
    <node
      class="wxFrame"
      class_name="FrameSizerFitTestBase"
      base_file="frame_sizer_fit_test_base"
      derived_class_name="FrameSizerFitTest"
      derived_file="frame_sizer_fit_test"
      set_sizer_and_fit="0"
      title="Frame Sizer Fit Test">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="frame_sizer"
        flags="wxEXPAND">
        <node
          class="wxStaticText"
          var_name="text_frame"
          label="Inside the frame"
          flags="wxEXPAND" />
      </node>
    </node>
  </node>
</wxUiEditorData>
