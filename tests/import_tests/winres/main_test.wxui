    </node>
    <node
      class="PopupMenu"
      class_name="Framemenu">
      <node
        class="wxMenuItem"
        help="Opens selected item"
        id="IDM_OPEN"
        label="&amp;Open"
        shortcut="Enter" />
      <node
        class="wxMenuItem"
        help="Edits selected item using notepad.exe"
        id="IDM_EDIT"
        label="Edit"
        shortcut="F12" />
      <node
        class="wxMenuItem"
        help="Moves selected item"
        id="IDM_MOVE"
        label="&amp;Move..."
        shortcut="F7" />
      <node
        class="wxMenuItem"
        help="Copies files and directories"
        id="IDM_COPY"
        label="&amp;Copy..."
        shortcut="F8" />
      <node
        class="wxMenuItem"
        help="Copies one or more files to the clipboard"
        id="IDM_COPYTOCLIPBOARD"
        label="Copy to Clip&amp;board"
        shortcut="Ctrl+C" />
      <node
        class="wxMenuItem"
        help="Cuts one or more files to the clipboard"
        id="IDM_CUTTOCLIPBOARD"
        label="Cut to Clipboard"
        shortcut="Ctrl+X" />
      <node
        class="wxMenuItem"
        help="Paste file from clipboard to current directory"
        id="IDM_PASTE"
        label="&amp;Paste"
        shortcut="Ctrl+V" />
      <node
        class="wxMenuItem"
        help="Deletes files and directories"
        id="IDM_DELETE"
        label="&amp;Delete..."
        shortcut="Del" />
      <node
        class="wxMenuItem"
        help="Renames a file or directory"
        id="IDM_RENAME"
        label="Re&amp;name..."
        shortcut="F2" />
      <node
        class="wxMenuItem"
        help="Sets file attributes and displays properties"
        id="IDM_ATTRIBS"
        label="Proper&amp;ties..."
        shortcut="Alt+Enter" />
      <node
        class="separator" />
      <node
        class="wxMenuItem"
        help="Compresses a file or directory"
        id="IDM_COMPRESS"
        label="Compre&amp;ss..." />
      <node
        class="wxMenuItem"
        help="Uncompresses a file or directory"
        id="IDM_UNCOMPRESS"
        label="&amp;Uncompress..." />
      <node
        class="separator" />
      <node
        class="wxMenuItem"
        help="Starts or opens an application or document"
        id="IDM_RUN"
        label="&amp;Run..." />
      <node
        class="wxMenuItem"
        help="Prints a document"
        id="IDM_PRINT"
        label="Pr&amp;int..." />
      <node
        class="wxMenuItem"
        help="Associates a file with an application"
        id="IDM_ASSOCIATE"
        label="&amp;Associate..." />
      <node
        class="separator" />
      <node
        class="wxMenuItem"
        help="Creates a directory"
        id="IDM_MAKEDIR"
        label="Cr&amp;eate Directory..."
        shortcut="Ctrl+Shift+N" />
      <node
        class="wxMenuItem"
        help="Searches for files and directories"
        id="IDM_SEARCH"
        label="Searc&amp;h..."
        shortcut="Ctrl+F" />
      <node
        class="wxMenuItem"
        help="Selects files and directories"
        id="IDM_SELECT"
        label="Select &amp;Files..." />
      <node
        class="wxMenuItem"
        id="IDM_STARTBASHSHELL"
        label="Start Bash Shell..." />
      <node
        class="wxMenuItem"
        id="IDM_STARTCMDSHELL"
        label="Start Cmd Shel&amp;l..." />
      <node
        class="wxMenuItem"
        id="IDM_STARTPOWERSHELL"
        label="Start Po&amp;werShell..." />
      <node
        class="wxMenuItem"
        id="IDM_GOTODIR"
        label="&amp;Goto Directory..."
