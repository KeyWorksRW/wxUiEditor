<?xml version="1.0"?>
<wxUiEditorData
  data_version="16">
  <node
    class="Project"
    generate_languages="C++"
    internationalize="1">
    <node
      class="wxDialog"
      class_name="QuotedStringTestBase"
      derived_class_name="QuotedStringTest"
      derived_file="quoted_string_test"
      size="500,300"
      title="Caf&#233; quoted string test"
      generate_const_values="1"
      base_file="quoted_string_test_base">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="quoted_string_sizer"
        flags="wxEXPAND">
        <node
          class="wxStaticText"
          var_name="text_ascii"
          label="Plain ASCII label"
          flags="wxEXPAND" />
        <node
          class="wxStaticText"
          var_name="text_degree_sign"
          label="Move the C-Arm to its 45&#176; position"
          flags="wxEXPAND" />
        <node
          class="wxStaticText"
          var_name="text_accented"
          label="P&#233;rez"
          flags="wxEXPAND" />
      </node>
    </node>
  </node>
</wxUiEditorData>
