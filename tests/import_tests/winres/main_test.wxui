                class="wxTextCtrl"
                var_comment="IDC_COL_INCREASENUM_EDIT"
                var_name="m_textCtrl4"
                minimum_size="38,-1d" />
              <node
                class="spacer" />
              <node
                class="wxStaticText"
                label="Repeat :"
