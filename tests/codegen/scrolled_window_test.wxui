<?xml version="1.0"?>
<wxUiEditorData
  data_version="16">
  <node
    class="Project"
    generate_languages="C++">
    <node
      class="wxDialog"
      class_name="ScrolledWindowTestBase"
      base_file="scrolled_window_test_base"
      derived_class_name="ScrolledWindowTest"
      derived_file="scrolled_window_test"
      size="500,400"
      title="Scrolled Window Test">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="dialog_sizer"
        flags="wxEXPAND">
        <node
          class="wxScrolledWindow"
          var_name="m_scroll_panel"
          scroll_rate_x="5"
          scroll_rate_y="5"
          proportion="1"
          flags="wxEXPAND">
          <node
            class="wxBoxSizer"
            orientation="wxVERTICAL"
            var_name="scroll_sizer">
            <node
              class="wxStaticText"
              var_name="text_inside"
              label="Inside the scrolled window"
              flags="wxEXPAND" />
          </node>
        </node>
        <node
          class="wxPanel"
          var_name="m_plain_panel"
          proportion="1"
          flags="wxEXPAND">
          <node
            class="wxBoxSizer"
            orientation="wxVERTICAL"
            var_name="panel_sizer">
            <node
              class="wxStaticText"
              var_name="text_in_panel"
              label="Inside the plain panel"
              flags="wxEXPAND" />
          </node>
        </node>
      </node>
    </node>
  </node>
</wxUiEditorData>
