<?xml version="1.0"?>
<wxUiEditorData
  data_version="17">
  <node
    class="Project"
    art_directory="../art_src/"
    base_directory="../internal/generated"
    cmake_file="wxui_internal.cmake"
    cmake_varname="wxue_internal_generated_code"
    common_art_header="ui_images.h"
    cpp_line_length="125"
    derived_directory="../internal"
    generate_cmake="1"
    minimum_compiler="17"
    wxWidgets_version="3.3.0">
    <node
      class="wxDialog"
      class_name="DebugSettingsBase"
      cpp_conditional="defined(INTERNAL_TESTING)"
      persist="1"
      style="wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER"
      title="Test Settings"
      base_file="debugsettings_base"
      derived_class_name="DebugSettings"
      derived_file="../debugsettings.cpp"
      private_members="1"
      wxEVT_INIT_DIALOG="OnInit">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="parent_sizer">
        <node
          class="wxStaticBoxSizer"
          label="MSG Window Settings"
          flags="wxEXPAND">
          <node
            class="wxBoxSizer"
            flags="wxEXPAND">
            <node
              class="wxCheckBox"
              class_access="none"
              label="Display MSG Window"
              var_name="checkBox"
              validator_variable="m_DisplayMsgWindow"
              tooltip="If checked, the MSG window will be displayed the first time it receives a non-filtered MSG. If unchecked, the window is never displayed unless you go here and click the Show Now button."
              alignment="wxALIGN_CENTER" />
            <node
              class="spacer"
              width="15"
              flags="wxEXPAND" />
            <node
              class="wxButton"
              label="Show Now"
              wxEVT_BUTTON="OnShowNow" />
          </node>
          <node
            class="wxBoxSizer"
            orientation="wxVERTICAL"
            var_name="box_sizer2"
            flags="wxEXPAND">
            <node
              class="wxCheckBox"
              class_access="none"
              label="Display MSG_INFO() messages"
              var_name="checkBox2"
              validator_variable="m_DisplayMsgInfo" />
            <node
              class="wxCheckBox"
              class_access="none"
              label="Display MSG_EVENT() messages"
              var_name="checkBox3"
              validator_variable="m_DisplayMsgEvent" />
            <node
              class="wxCheckBox"
              class_access="none"
              label="Display MSG_WARNING() messages"
              var_name="checkBox4"
              validator_variable="m_DisplayMsgWarning" />
          </node>
          <node
            class="spacer"
            height="10" />
          <node
            class="wxBoxSizer"
            orientation="wxVERTICAL"
            var_name="box_sizer_2"
            flags="wxEXPAND">
            <node
              class="wxCheckBox"
              class_access="none"
              label="Display creation info"
              var_name="checkBox_2"
              validator_variable="m_FireCreationMsgs"
              tooltip="MSG_INFO called when nav, prop, and mockup panels have their contents recreated." />
          </node>
        </node>
        <node
          class="wxStdDialogButtonSizer"
          class_access="protected:"
          static_line="0"
          var_name="std_button_sizer"
          flags="wxEXPAND"
          OKButtonClicked="OnOK" />
      </node>
    </node>
    <node
      class="wxDialog"
      class_name="ConvertImageBase"
      cpp_conditional="defined(INTERNAL_TESTING)"
      title="Convert Image"
      minimum_size="-1,-1"
      size="-1,-1"
      base_file="convert_img_base"
      derived_class_name="../convert_img">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="parent_sizer"
        flags="wxEXPAND">
        <node
          class="wxBoxSizer"
          borders="wxLEFT|wxRIGHT|wxTOP"
          flags="wxEXPAND">
          <node
            class="wxCollapsiblePane"
            class_access="none"
            collapsed="1"
            label="Dialog Description"
            var_name="collapsiblePane"
            borders="wxLEFT|wxRIGHT|wxTOP"
            flags="wxEXPAND"
            proportion="1">
            <node
              class="wxBoxSizer"
              var_name="box_sizer2">
              <node
                class="wxStaticText"
                label="This dialog can be used to convert an image into a file that can be #included into a source file. The original image can be any file format that wxWidgets supports.&#10;&#10;The header output type is an array containing the image data in whatever format you choose. While the disk file size might be larger than an XPM file, the size in your executable will typically be quite a bit smaller."
                var_name="m_staticDescription"
                wrap="400" />
            </node>
          </node>
        </node>
        <node
          class="wxFlexGridSizer"
          growablecols="1"
          flags="wxEXPAND">
          <node
            class="wxStaticText"
            label="&amp;Source:"
            var_name="m_staticOriginal_2"
            alignment="wxALIGN_CENTER" />
          <node
            class="wxFilePickerCtrl"
            var_name="m_fileOriginal"
            wildcard="Select file(s)&quot;, &quot;All files|*.*|PNG|*.png|XPM|*.xpm|Tiff|*.tif;*.tiff|Bitmaps|*.bmp|Icon|*.ico||"
            size="300,-1"
            flags="wxEXPAND"
            wxEVT_FILEPICKER_CHANGED="OnInputChange" />
          <node
            class="wxStaticText"
            label="O&amp;utput:"
            var_name="m_staticHeader"
            alignment="wxALIGN_CENTER" />
          <node
            class="wxFilePickerCtrl"
            style="wxFLP_SAVE|wxFLP_USE_TEXTCTRL"
            var_name="m_fileOutput"
            wildcard="Header files|*.h_img||"
            flags="wxEXPAND"
            wxEVT_FILEPICKER_CHANGED="OnOutputChange" />
        </node>
        <node
          class="wxStaticBoxSizer"
          label="Output Type">
          <node
            class="wxChoicebook"
            style="wxCHB_LEFT"
            wxEVT_CHOICEBOOK_PAGE_CHANGED="OnPageChanged">
            <node
              class="BookPage"
              label="Header"
              var_name="header_page"
              background_colour="wxSYS_COLOUR_BTNFACE"
              window_style="wxTAB_TRAVERSAL">
              <node
                class="wxBoxSizer"
                orientation="wxVERTICAL"
                var_name="parent_sizer_2">
                <node
                  class="wxStaticBoxSizer"
                  label="Settings"
                  var_name="hdr_static_box">
                  <node
                    class="wxBoxSizer"
                    orientation="wxVERTICAL"
                    var_name="box_sizer_2"
                    flags="wxEXPAND">
                    <node
                      class="wxCheckBox"
                      checked="1"
                      label="Convert to &amp;PNG"
                      var_name="m_check_make_png"
                      tooltip="If checked, image will be converted to PNG before being saved."
                      wxEVT_CHECKBOX="OnCheckPngConversion" />
                    <node
                      class="wxCheckBox"
                      label="&amp;Force Mask"
                      var_name="m_ForceHdrMask"
                      tooltip="Check this to override any mask specified in the original image file."
                      wxEVT_CHECKBOX="OnForceHdrMask" />
                    <node
                      class="wxBoxSizer"
                      var_name="box_sizer_3">
                      <node
                        class="spacer"
                        width="10" />
                      <node
                        class="wxComboBox"
                        style="wxCB_READONLY"
                        var_name="m_comboHdrMask"
                        size="150,-1"
                        borders="wxLEFT|wxRIGHT|wxBOTTOM"
                        wxEVT_COMBOBOX="OnComboHdrMask" />
                    </node>
                    <node
                      class="wxBoxSizer"
                      var_name="box_sizer_5"
                      borders="wxRIGHT|wxLEFT">
                      <node
                        class="spacer"
                        width="10" />
                      <node
                        class="wxStaticText"
                        label="0 0 0"
                        var_name="m_staticHdrRGB"
                        borders="wxRIGHT|wxLEFT" />
                    </node>
                  </node>
                </node>
              </node>
            </node>
            <node
              class="BookPage"
              label="XPM"
              var_name="xpm_page"
              background_colour="wxSYS_COLOUR_BTNFACE"
              window_style="wxTAB_TRAVERSAL">
              <node
                class="wxBoxSizer"
                orientation="wxVERTICAL"
                var_name="parent_sizer_3">
                <node
                  class="wxStaticBoxSizer"
                  label="Settings"
                  var_name="mask_static_box">
                  <node
                    class="wxBoxSizer"
                    orientation="wxVERTICAL"
                    var_name="box_sizer7"
                    flags="wxEXPAND">
                    <node
                      class="wxCheckBox"
                      checked="1"
                      label="&amp;Alpha Channel to Mask"
                      var_name="m_ConvertAlphaChannel"
                      tooltip="Check this to replace any alpha channel with a mask."
                      flags="wxEXPAND"
                      wxEVT_CHECKBOX="OnConvertAlpha" />
                    <node
                      class="wxCheckBox"
                      label="&amp;Force Mask"
                      var_name="m_ForceXpmMask"
                      tooltip="Check this to override any mask specified in the original image file."
                      wxEVT_CHECKBOX="OnForceXpmMask" />
                    <node
                      class="wxBoxSizer"
                      var_name="box_sizer_4">
                      <node
                        class="spacer"
                        width="10" />
                      <node
                        class="wxComboBox"
                        style="wxCB_READONLY"
                        var_name="m_comboXpmMask"
                        size="150,-1"
                        borders="wxLEFT|wxRIGHT|wxBOTTOM"
                        wxEVT_COMBOBOX="OnComboXpmMask" />
                    </node>
                    <node
                      class="wxBoxSizer"
                      var_name="box_sizer_6"
                      borders="wxRIGHT|wxLEFT">
                      <node
                        class="spacer"
                        width="10" />
                      <node
                        class="wxStaticText"
                        label="0 0 0"
                        var_name="m_staticXpmRGB"
                        borders="wxRIGHT|wxLEFT" />
                    </node>
                  </node>
                </node>
              </node>
            </node>
          </node>
        </node>
        <node
          class="wxBoxSizer"
          var_name="box_sizer6"
          borders="wxTOP|wxRIGHT|wxLEFT"
          flags="wxEXPAND">
          <node
            class="wxStaticText"
            label="16 x 16"
            var_name="m_staticDimensions"
            hidden="1"
            alignment="wxALIGN_CENTER"
            borders="wxTOP|wxRIGHT|wxLEFT"
            proportion="1" />
        </node>
        <node
          class="wxGridSizer"
          var_name="grid_sizer2"
          flags="wxEXPAND"
          proportion="1">
          <node
            class="wxStaticText"
            label="Source"
            var_name="m_staticOriginal"
            hidden="1"
            alignment="wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_HORIZONTAL"
            borders="wxLEFT|wxRIGHT|wxTOP" />
          <node
            class="wxStaticText"
            label="Current"
            var_name="m_staticOutput"
            hidden="1"
            alignment="wxALIGN_CENTER"
            borders="wxLEFT|wxRIGHT|wxTOP" />
          <node
            class="wxStaticBitmap"
            class_access="protected:"
            var_name="m_bmpOriginal"
            hidden="1"
            alignment="wxALIGN_CENTER" />
          <node
            class="wxStaticBitmap"
            class_access="protected:"
            var_name="m_bmpOutput"
            hidden="1"
            alignment="wxALIGN_CENTER" />
        </node>
        <node
          class="wxFlexGridSizer"
          cols="1"
          var_name="flex_grid_sizer2"
          flags="wxEXPAND">
          <node
            class="wxStaticText"
            label="save"
            var_name="m_staticSave"
            hidden="1"
            flags="wxEXPAND" />
          <node
            class="wxStaticText"
            label="size"
            var_name="m_staticSize"
            hidden="1"
            flags="wxEXPAND" />
        </node>
        <node
          class="wxGridSizer"
          flags="wxEXPAND">
          <node
            class="wxButton"
            label="Convert"
            var_name="m_btnConvert"
            wxEVT_BUTTON="OnConvert" />
          <node
            class="wxButton"
            label="Close"
            var_name="m_btnClose"
            id="wxID_OK"
            alignment="wxALIGN_RIGHT" />
        </node>
      </node>
    </node>
    <node
      class="wxDialog"
      class_name="NodeInfoBase"
      title="Node Information"
      base_file="node_info_base"
      class_members="&quot;Node* m_node { nullptr };&quot;"
      class_methods="&quot;void SetNode(Node* node) { m_node = node; }&quot;"
      derived_class_name="NodeInfo"
      derived_file="node_info"
      private_members="1"
      wxEVT_INIT_DIALOG="OnInit">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="parent_sizer"
        flags="wxEXPAND">
        <node
          class="wxStaticBoxSizer"
          label="Selected Node"
          var_name="static_box_2">
          <node
            class="wxStaticText"
            label="Name:"
            var_name="m_txt_generator" />
          <node
            class="wxStaticText"
            label="Type:"
            var_name="m_txt_type" />
          <node
            class="wxStaticText"
            label="Memory:"
            var_name="m_txt_memory" />
        </node>
        <node
          class="wxStaticBoxSizer"
          label="Memory Usage"
          flags="wxEXPAND">
          <node
            class="wxStaticText"
            label="Project:"
            var_name="m_txt_project" />
          <node
            class="wxStaticText"
            label="Clipboard:"
            var_name="m_txt_clipboard" />
        </node>
        <node
          class="wxStdDialogButtonSizer"
          Cancel="0"
          Close="1"
          OK="0"
          default_button="Close"
          flags="wxEXPAND" />
      </node>
    </node>
    <node
      class="wxDialog"
      class_name="XrcPreview"
      persist="1"
      style="wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER"
      title="Test XRC"
      minimum_size="1200,1250"
      base_file="xrcpreview"
      header_preamble="class Node;"
      class_members="&quot;Node* m_form_node;&quot;"
      class_methods="&quot;void Generate(Node* form_node = nullptr);&quot;"
      derived_class_name="XrcPreview"
      derived_file="xrcpreview"
      use_derived_class="0"
      wxEVT_INIT_DIALOG="OnInit">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="dlg_sizer"
        flags="wxEXPAND">
        <node
          class="wxBoxSizer"
          orientation="wxVERTICAL"
          flags="wxEXPAND"
          proportion="1">
          <node
            class="wxCollapsiblePane"
            collapsed="1"
            label="Information">
            <node
              class="wxBoxSizer"
              orientation="wxVERTICAL"
              var_name="box_sizer_4">
              <node
                class="wxStaticText"
                class_access="none"
                label="Click Generate then Preview to display a form. You can edit the generated content and Preview that if needed."
                var_name="static_text2"
                borders="wxTOP|wxRIGHT|wxLEFT" />
              <node
                class="wxStaticText"
                label="Preview only works with Dialogs. Be certain the dialog will be visible and has a close box in the title bar!"
                borders="wxRIGHT|wxLEFT" />
            </node>
          </node>
          <node
            class="wxBoxSizer"
            var_name="box_sizer_2"
            flags="wxEXPAND">
            <node
              class="wxButton"
              class_access="none"
              label="&amp;Generate..."
              var_name="btn_3"
              bitmap="SVG;generate.svg;[16,16]"
              tooltip="Choose a form then generate the XRC code"
              wxEVT_BUTTON="OnGenerate" />
            <node
              class="wxButton"
              label="&amp;Preview..."
              var_name="m_btn_preview"
              bitmap="SVG;xrc_preview.svg;[16,16]"
              tooltip="Use wxXmlResource to load and display the contents"
              wxEVT_BUTTON="OnPreview" />
            <node
              class="wxButton"
              label="&amp;Verify"
              var_name="m_btn_import"
              bitmap="SVG;import.svg;[16,16]"
              tooltip="Verify that the current contents can be imported"
              wxEVT_BUTTON="OnVerify" />
            <node
              class="wxButton"
              label="&amp;Export..."
              var_name="m_btn__export"
              bitmap="Art;wxART_FILE_SAVE_AS|wxART_MENU"
              tooltip="Load current contents into XML, then Export to a file of your choice"
              wxEVT_BUTTON="OnExport" />
            <node
              class="wxButton"
              label="Co&amp;mpare..."
              var_name="m_btnCompare"
              tooltip="Only valid if an XRC was imported. Compares original and generated."
              wxEVT_BUTTON="OnCompare" />
            <node
              class="wxButton"
              class_access="none"
              label="&amp;Duplicate"
              var_name="btn3"
              bitmap="Art;wxART_ADD_BOOKMARK|wxART_MENU"
              tooltip="Load current contents into XML, then Export to a file of your choice"
              wxEVT_BUTTON="OnDuplicate" />
            <node
              class="wxButton"
              class_access="none"
              label="&amp;Clear"
              var_name="btn_2"
              bitmap="Art;wxART_CUT|wxART_MENU"
              tooltip="Remove all of the contents"
              wxEVT_BUTTON="OnClear" />
          </node>
          <node
            class="wxBoxSizer"
            var_name="box_sizer2"
            borders="wxRIGHT|wxLEFT"
            flags="wxEXPAND">
            <node
              class="wxStaticText"
              label="C&amp;ontents:"
              var_name="m_contents"
              alignment="wxALIGN_BOTTOM"
              borders="wxTOP|wxRIGHT|wxLEFT"
              proportion="1" />
            <node
              class="wxBoxSizer"
              var_name="box_sizer3">
              <node
                class="wxSearchCtrl"
                minimum_size="200,-1"
                borders="wxBOTTOM|wxRIGHT|wxLEFT"
                wxEVT_SEARCHCTRL_SEARCH_BTN="OnSearch" />
            </node>
          </node>
          <node
            class="wxBoxSizer"
            var_name="box_sizer_3"
            flags="wxEXPAND"
            proportion="1">
            <node
              class="wxStyledTextCtrl"
              fold_margin="1"
              indentation_size="0"
              lexer="XML"
              flags="wxEXPAND"
              proportion="1" />
          </node>
        </node>
        <node
          class="wxStdDialogButtonSizer"
          Cancel="0"
          Close="1"
          OK="0"
          default_button="none"
          flags="wxEXPAND" />
      </node>
    </node>
    <node
      class="wxDialog"
      class_name="NodeSearchDlgBase"
      persist="1"
      style="wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER"
      title="Node Search"
      minimum_size="-1,-1"
      base_file="node_search_dlg_base"
      derived_class_name="NodeSearchDlg"
      derived_file="../node_search_dlg.cpp"
      private_members="1"
      wxEVT_INIT_DIALOG="OnInit">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="dlg_sizer"
        minimum_size="-1,-1"
        flags="wxEXPAND">
        <node
          class="wxBoxSizer"
          var_name="box_sizer_3"
          minimum_size="500,-1"
          flags="wxEXPAND">
          <node
            class="wxRadioButton"
            checked="1"
            class_access="none"
            label="&amp;Generators"
            style="wxRB_GROUP"
            var_name="radioBtn_Generators"
            get_function="isSearchGenerators"
            validator_variable="m_search_generators2"
            wxEVT_RADIOBUTTON="OnGenerators" />
          <node
            class="wxRadioButton"
            class_access="none"
            label="&amp;Variables"
            var_name="radio_variables"
            get_function="isSearchVarnames"
            validator_variable="m_search_varnames2"
            wxEVT_RADIOBUTTON="OnVariables" />
          <node
            class="wxRadioButton"
            class_access="none"
            label="&amp;Labels"
            var_name="radioBtn_Labels"
            get_function="isSearchLabels"
            validator_variable="m_search_labels2"
            wxEVT_RADIOBUTTON="OnLabels" />
          <node
            class="wxRadioButton"
            class_access="none"
            label="&amp;IDs"
            var_name="radioBtn_IDs"
            get_function="isSearchIDs"
            validator_variable="m_search_ids2"
            wxEVT_RADIOBUTTON="OnIDs" />
          <node
            class="wxButton"
            class_access="none"
            label="Unused..."
            var_name="btn"
            borders="wxBOTTOM|wxRIGHT|wxLEFT"
            wxEVT_BUTTON="OnUnused" />
        </node>
        <node
          class="wxBoxSizer">
          <node
            class="wxTextCtrl"
            focus="1"
            hint="Enter item to search for"
            var_name="m_text_search"
            borders="wxTOP|wxRIGHT|wxLEFT"
            wxEVT_TEXT="OnSearchText" />
        </node>
        <node
          class="wxBoxSizer"
          var_name="box_sizer_4"
          minimum_size="500,-1"
          borders="wxBOTTOM|wxRIGHT|wxLEFT"
          flags="wxEXPAND"
          proportion="1">
          <node
            class="wxBoxSizer"
            orientation="wxVERTICAL"
            var_name="box_sizer_5"
            flags="wxEXPAND"
            proportion="1">
            <node
              class="wxStaticText"
              class_access="none"
              label="&amp;Located:"
              var_name="staticText"
              borders="wxTOP|wxRIGHT|wxLEFT" />
            <node
              class="wxListBox"
              minimum_size="240,250"
              flags="wxEXPAND"
              proportion="1"
              wxEVT_LISTBOX="OnSelectLocated" />
          </node>
          <node
            class="wxBoxSizer"
            orientation="wxVERTICAL"
            var_name="box_sizer_6"
            flags="wxEXPAND"
            proportion="1">
            <node
              class="wxStaticText"
              class_access="none"
              label="&amp;Forms:"
              var_name="staticText_2"
              borders="wxTOP|wxRIGHT|wxLEFT" />
            <node
              class="wxListBox"
              style="wxLB_SORT"
              var_name="m_listbox_forms"
              minimum_size="-1,250"
              flags="wxEXPAND"
              proportion="1" />
          </node>
        </node>
        <node
          class="wxStdDialogButtonSizer"
          flags="wxEXPAND"
          OKButtonClicked="OnOK" />
      </node>
    </node>
    <node
      class="wxFrame"
      class_name="MsgFrameBase"
      title="wxUiEditor Messages"
      base_file="msgframe_base"
      derived_class_name="MsgFrame"
      derived_file="../msgframe"
      size="-1,-1"
      window_style="wxTAB_TRAVERSAL"
      wxEVT_CLOSE_WINDOW="OnClose">
      <node
        class="wxMenuBar"
        class_access="none"
        var_name="menubar">
        <node
          class="wxMenu"
          class_access="none"
          label="&amp;File"
          var_name="menu_file">
          <node
            class="wxMenuItem"
            bitmap="Art;wxART_FILE_SAVE_AS|wxART_MENU"
            id="wxID_SAVEAS"
            label=""
            var_name="menu_item_saveas"
            wxEVT_MENU="OnSaveAs" />
          <node
            class="separator" />
          <node
            class="wxMenuItem"
            bitmap="Art;wxART_CUT|wxART_MENU"
            id="wxID_CLEAR"
            label=""
            var_name="menu_item_clear"
            wxEVT_MENU="OnClear" />
          <node
            class="wxMenuItem"
            bitmap="SVG;hide.svg;[24,24]"
            id="id_hide"
            label="&amp;Hide"
            var_name="menu_item_hide"
            wxEVT_MENU="OnHide" />
        </node>
        <node
          class="wxMenu"
          class_access="none"
          label="&amp;View"
          var_name="menu_view">
          <node
            class="wxMenuItem"
            bitmap="Art;wxART_WARNING|wxART_MENU"
            class_access="protected:"
            id="id_warning_msgs"
            kind="wxITEM_CHECK"
            label="Warnings"
            var_name="m_menu_item_warnings"
            wxEVT_MENU="OnWarnings" />
          <node
            class="wxMenuItem"
            bitmap="Art;wxART_TIP|wxART_MENU"
            class_access="protected:"
            id="id_event_msgs"
            kind="wxITEM_CHECK"
            label="Events"
            var_name="m_menu_item_events"
            wxEVT_MENU="OnEvents" />
          <node
            class="wxMenuItem"
            bitmap="Art;wxART_INFORMATION|wxART_MENU"
            class_access="protected:"
            id="wxID_INFO"
            kind="wxITEM_CHECK"
            label=""
            var_name="m_menu_item_info"
            wxEVT_MENU="OnInfo" />
        </node>
      </node>
      <node
        class="wxToolBar"
        var_name="m_tool_bar">
        <node
          class="tool"
          bitmap="SVG;saveas.svg;[24,24]"
          id="wxID_SAVEAS"
          label=""
          var_name="tool_saveas"
          wxEVT_TOOL="OnSaveAs" />
        <node
          class="toolSeparator" />
        <node
          class="tool"
          bitmap="SVG;clear.svg;[24,24]"
          label=""
          var_name="tool_item_clear"
          wxEVT_TOOL="OnClear" />
        <node
          class="tool"
          bitmap="SVG;hide.svg;[24,24]"
          id="id_hide"
          label=""
          var_name="tool_hide"
          wxEVT_TOOL="OnHide" />
      </node>
      <node
        class="wxAuiNotebook"
        art_provider="wxAuiGenericTabArt"
        var_name="m_aui_notebook"
        background_colour="wxSYS_COLOUR_BTNFACE"
        flags="wxEXPAND"
        proportion="1"
        wxEVT_AUINOTEBOOK_PAGE_CHANGED="OnPageChanged">
        <node
          class="BookPage"
          class_access="protected:"
          label="Log"
          var_name="m_page_log"
          background_colour="wxSYS_COLOUR_BTNFACE"
          window_style="wxTAB_TRAVERSAL">
          <node
            class="wxBoxSizer"
            orientation="wxVERTICAL"
            var_name="log_sizer">
            <node
              class="wxTextCtrl"
              style="wxTE_MULTILINE|wxTE_READONLY|wxTE_RICH|wxHSCROLL"
              minimum_size="350,300"
              border_size="0"
              flags="wxEXPAND"
              proportion="1" />
          </node>
        </node>
        <node
          class="BookPage"
          class_access="protected:"
          label="Node"
          var_name="m_page_node"
          background_colour="wxSYS_COLOUR_BTNFACE"
          window_style="wxTAB_TRAVERSAL">
          <node
            class="wxBoxSizer"
            orientation="wxVERTICAL"
            var_name="node_sizer">
            <node
              class="wxStaticBoxSizer"
              label="Selected Node"
              var_name="static_box_2"
              flags="wxEXPAND">
              <node
                class="wxBoxSizer"
                flags="wxEXPAND">
                <node
                  class="wxStaticText"
                  label="Name:"
                  var_name="m_txt_generator"
                  flags="wxEXPAND"
                  proportion="1" />
                <node
                  class="wxButton"
                  class_access="none"
                  label="Parent..."
                  var_name="btn"
                  alignment="wxALIGN_CENTER_VERTICAL"
                  wxEVT_BUTTON="OnParent" />
              </node>
              <node
                class="wxStaticText"
                label="Type:"
                var_name="m_txt_type" />
              <node
                class="wxStaticText"
                label="Memory:"
                var_name="m_txt_memory" />
              <node
                class="wxHyperlinkCtrl"
                label="wxWidgets Documentation"
                url="https://docs.wxwidgets.org/latest/"
                flags="wxEXPAND" />
            </node>
            <node
              class="wxStaticBoxSizer"
              label="Memory Usage"
              flags="wxEXPAND">
              <node
                class="wxStaticText"
                label="Project:"
                var_name="m_txt_project" />
              <node
                class="wxStaticText"
                label="Clipboard:"
                var_name="m_txt_clipboard" />
            </node>
          </node>
        </node>
        <node
          class="BookPage"
          class_access="protected:"
          label="XRC"
          var_name="m_page_xrc"
          background_colour="wxSYS_COLOUR_BTNFACE"
          window_style="wxTAB_TRAVERSAL">
          <node
            class="wxBoxSizer"
            orientation="wxVERTICAL"
            var_name="page_sizer">
            <node
              class="wxBoxSizer"
              var_name="box_sizer_3"
              flags="wxEXPAND"
              proportion="1">
              <node
                class="wxStyledTextCtrl"
                fold_margin="1"
                lexer="XML"
                read_only="1"
                flags="wxEXPAND"
                proportion="1" />
            </node>
          </node>
        </node>
      </node>
    </node>
    <node
      class="wxDialog"
      class_name="UnusedGeneratorsBase"
      title="Unused Generators"
      base_file="unused_gen_dlg_base"
      derived_class_name="UnusedGenerators"
      derived_file="../unusedgenerators"
      wxEVT_INIT_DIALOG="OnInit">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="dlg_sizer">
        <node
          class="wxStaticText"
          class_access="none"
          label="Unused generators in the entire project"
          var_name="staticText"
          wrap="200" />
        <node
          class="wxListBox"
          minimum_size="240,250"
          flags="wxEXPAND" />
        <node
          class="wxButton"
          class_access="none"
          label="&amp;Save..."
          var_name="btn"
          wxEVT_BUTTON="OnSave" />
        <node
          class="wxStdDialogButtonSizer"
          Cancel="0"
          flags="wxEXPAND" />
      </node>
    </node>
    <node
      class="wxDialog"
      class_name="UndoInfoBase"
      title="Undo/Redo stack information"
      base_file="undo_info_base"
      derived_class_name="UndoInfo"
      derived_file="../undo_info"
      private_members="1"
      wxEVT_INIT_DIALOG="OnInit">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="dlg_sizer"
        flags="wxEXPAND">
        <node
          class="wxFlexGridSizer">
          <node
            class="wxStaticText"
            class_access="none"
            label="Number of Undo items:"
            var_name="staticText_5" />
          <node
            class="wxStaticText"
            label="..."
            var_name="m_txt_undo_items" />
          <node
            class="wxStaticText"
            class_access="none"
            label="Number of Redo items:"
            var_name="staticText_6" />
          <node
            class="wxStaticText"
            label="..."
            var_name="m_txt_redo_items" />
        </node>
        <node
          class="wxStaticText"
          class_access="none"
          label="The amount of memory used is determined by the reference count of the nodes. If the node is not orphaned, then it consumes no additional memory other than the shared_ptr itself."
          var_name="staticText"
          wrap="300"
          window_style="wxBORDER_SIMPLE" />
        <node
          class="wxFlexGridSizer"
          var_name="flex_grid_sizer_2">
          <node
            class="wxStaticText"
            class_access="none"
            label="Undo Memory:"
            var_name="staticText_7" />
          <node
            class="wxStaticText"
            label="..."
            var_name="m_txt_undo_memory" />
          <node
            class="wxStaticText"
            class_access="none"
            label="Redo Memory:"
            var_name="staticText_8" />
          <node
            class="wxStaticText"
            label="..."
            var_name="m_txt_redo_memory" />
        </node>
        <node
          class="wxStdDialogButtonSizer"
          Cancel="0"
          Close="1"
          OK="0"
          default_button="none"
          flags="wxEXPAND" />
      </node>
    </node>
    <node
      class="wxDialog"
      class_name="ViewDetails_base"
      persist="1"
      style="wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER"
      title="Markdown + HTML comparison"
      minimum_size="1200,1200"
      base_file="viewdetails_base"
      derived_class_name="ViewDetails"
      derived_file="../viewdetails_dlg.cpp"
      wxEVT_INIT_DIALOG="OnInit">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="dlg_sizer">
        <node
          class="wxSplitterWindow"
          min_pane_size="600"
          persist_name="info"
          sashpos="600"
          size="400,-1"
          flags="wxEXPAND"
          proportion="1">
          <node
            class="wxStyledTextCtrl"
            lexer="MARKDOWN"
            var_name="m_markdown"
            view_whitespace="visible after indent"
            flags="wxEXPAND"
            proportion="1" />
          <node
            class="wxStyledTextCtrl"
            lexer="HTML"
            var_name="m_html"
            view_whitespace="visible after indent"
            flags="wxEXPAND"
            proportion="1" />
        </node>
        <node
          class="wxStdDialogButtonSizer"
          Cancel="0"
          Close="1"
          OK="0"
          default_button="Close"
          static_line="0"
          flags="wxEXPAND" />
      </node>
    </node>
    <node
      class="wxDialog"
      class_name="XrcListDlgBase"
      title="XRC Preview forms"
      base_file="xrc_list_dlg_base"
      local_hdr_includes="../nodes/node.h"
      derived_class_name="XrcListDlg"
      derived_file="../xrc_list_dlg.cpp"
      wxEVT_INIT_DIALOG="OnInit">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="dlg_sizer">
        <node
          class="wxStaticText"
          class_access="none"
          label="&amp;List of XRC previewable forms:"
          var_name="static_text" />
        <node
          class="wxListBox"
          minimum_size="200,175"
          flags="wxEXPAND" />
        <node
          class="wxStdDialogButtonSizer"
          flags="wxEXPAND"
          OKButtonClicked="OnOK" />
      </node>
    </node>
  </node>
</wxUiEditorData>
