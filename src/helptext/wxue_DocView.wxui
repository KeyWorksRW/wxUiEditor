<?xml version="1.0"?>
<wxUiEditorData
  data_version="17">
  <node
    class="Project"
    art_directory="../art_src/"
    base_directory="generated"
    cmake_file="docview.cmake"
    cmake_varname="docview_files"
    common_art_header="ui_images.h"
    cpp_line_length="125"
    generate_cmake="1"
    minimum_compiler="17">
    <node
      class="PanelForm"
      class_name="DocViewPanelBase"
      base_file="doc_view_panel_base"
      derived_class_name="DocViewPanel"
      derived_file="../helptext/doc_view_panel.cpp"
      wxEVT_UPDATE_UI="OnUpdateUI">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL">
        <node
          class="wxSplitterWindow"
          persist_name="rtf_html_sash"
          sashpos="75"
          var_name="m_splitter2"
          flags="wxEXPAND"
          proportion="1">
          <node
            class="wxPanel"
            minimum_size="175,-1"
            window_style="wxBORDER_THEME|wxTAB_TRAVERSAL">
            <node
              class="wxBoxSizer"
              orientation="wxVERTICAL"
              var_name="panel_sizer"
              minimum_size="-1,-1"
              flags="wxEXPAND">
              <node
                class="wxChoicebook"
                flags="wxEXPAND"
                proportion="1"
                wxEVT_CHOICEBOOK_PAGE_CHANGED="OnPageChanged">
                <node
                  class="BookPage"
                  class_access="protected:"
                  label="Search"
                  var_name="m_search_page"
                  background_colour="wxSYS_COLOUR_BTNFACE"
                  window_style="wxTAB_TRAVERSAL"
                  flags="wxEXPAND">
                  <node
                    class="wxBoxSizer"
                    orientation="wxVERTICAL"
                    var_name="box_sizer4">
                    <node
                      class="wxSearchCtrl"
                      cancel_button="1"
                      hint="Search documentation..."
                      style="wxTE_PROCESS_ENTER"
                      var_name="m_search_ctrl"
                      minimum_size="-1,-1"
                      flags="wxEXPAND"
                      wxEVT_SEARCHCTRL_CANCEL_BTN="OnSearchCancel"
                      wxEVT_TEXT="OnSearchTextChanged" />
                    <node
                      class="wxListBox"
                      focus="1"
                      var_name="m_search_listbox"
                      window_style="0"
                      borders="wxLEFT|wxRIGHT|wxBOTTOM"
                      flags="wxEXPAND"
                      proportion="1"
                      wxEVT_LISTBOX_DCLICK="OnDisplaySearchListItem" />
                  </node>
                </node>
                <node
                  class="BookPage"
                  class_access="protected:"
                  label="Classes"
                  var_name="m_classes_page"
                  background_colour="wxSYS_COLOUR_BTNFACE"
                  window_style="wxTAB_TRAVERSAL">
                  <node
                    class="wxBoxSizer"
                    orientation="wxVERTICAL"
                    var_name="page_sizer">
                    <node
                      class="wxTextCtrl"
                      style="wxTE_PROCESS_ENTER"
                      var_name="m_classes_textctrl"
                      flags="wxEXPAND"
                      wxEVT_KEY_DOWN="OnTextKeyDown"
                      wxEVT_TEXT_ENTER="OnIndexTextEnter"
                      wxEVT_TEXT="OnIndexTextChange" />
                    <node
                      class="wxListBox"
                      var_name="m_classes_listbox"
                      flags="wxEXPAND"
                      proportion="1"
                      wxEVT_LISTBOX_DCLICK="OnDblClickListBox" />
                  </node>
                </node>
                <node
                  class="BookPage"
                  class_access="protected:"
                  label="Events"
                  var_name="m_events_page"
                  background_colour="wxSYS_COLOUR_BTNFACE"
                  window_style="wxTAB_TRAVERSAL">
                  <node
                    class="wxBoxSizer"
                    orientation="wxVERTICAL"
                    var_name="page_sizer2">
                    <node
                      class="wxTextCtrl"
                      style="wxTE_PROCESS_ENTER"
                      var_name="m_events_textctrl"
                      flags="wxEXPAND"
                      wxEVT_KEY_DOWN="OnTextKeyDown"
                      wxEVT_TEXT_ENTER="OnIndexTextEnter"
                      wxEVT_TEXT="OnIndexTextChange" />
                    <node
                      class="wxListBox"
                      var_name="m_events_listbox"
                      flags="wxEXPAND"
                      proportion="1"
                      wxEVT_LISTBOX_DCLICK="OnDblClickListBox" />
                  </node>
                </node>
                <node
                  class="BookPage"
                  class_access="protected:"
                  label="Functions"
                  var_name="m_functions_page"
                  background_colour="wxSYS_COLOUR_BTNFACE"
                  window_style="wxTAB_TRAVERSAL">
                  <node
                    class="wxBoxSizer"
                    orientation="wxVERTICAL"
                    var_name="page_sizer4">
                    <node
                      class="wxTextCtrl"
                      style="wxTE_PROCESS_ENTER"
                      var_name="m_functions_textctrl"
                      flags="wxEXPAND"
                      wxEVT_KEY_DOWN="OnTextKeyDown"
                      wxEVT_TEXT_ENTER="OnIndexTextEnter"
                      wxEVT_TEXT="OnIndexTextChange" />
                    <node
                      class="wxListBox"
                      var_name="m_functions_listbox"
                      flags="wxEXPAND"
                      proportion="1"
                      wxEVT_LISTBOX_DCLICK="OnDblClickListBox" />
                  </node>
                </node>
                <node
                  class="BookPage"
                  class_access="protected:"
                  label="Overviews"
                  var_name="m_overviews_page"
                  background_colour="wxSYS_COLOUR_BTNFACE"
                  window_style="wxTAB_TRAVERSAL">
                  <node
                    class="wxBoxSizer"
                    orientation="wxVERTICAL"
                    var_name="page_sizer3">
                    <node
                      class="wxTextCtrl"
                      style="wxTE_PROCESS_ENTER"
                      var_name="m_overviews_textctrl"
                      flags="wxEXPAND"
                      wxEVT_KEY_DOWN="OnTextKeyDown"
                      wxEVT_TEXT_ENTER="OnIndexTextEnter"
                      wxEVT_TEXT="OnIndexTextChange" />
                    <node
                      class="wxListBox"
                      var_name="m_overviews_listbox"
                      flags="wxEXPAND"
                      proportion="1"
                      wxEVT_LISTBOX_DCLICK="OnDblClickListBox" />
                  </node>
                </node>
              </node>
            </node>
          </node>
          <node
            class="wxPanel"
            var_name="panel2"
            window_style="wxBORDER_THEME|wxTAB_TRAVERSAL">
            <node
              class="wxBoxSizer"
              orientation="wxVERTICAL"
              var_name="box_sizer3">
              <node
                class="wxAuiToolBar"
                var_name="m_aui_tool_bar"
                flags="wxEXPAND"
                wxEVT_UPDATE_UI="OnUpdateUI">
                <node
                  class="auitool"
                  bitmap="Art;wxART_GO_HOME|wxART_TOOLBAR;[24,24]"
                  class_access="protected:"
                  label=""
                  var_name="m_home"
                  wxEVT_TOOL="OnHome" />
                <node
                  class="auitool"
                  bitmap="Art;wxART_GO_BACK|wxART_TOOLBAR;[24,24]"
                  class_access="protected:"
                  initial_state="wxAUI_BUTTON_STATE_DISABLED"
                  label=""
                  var_name="m_back"
                  wxEVT_TOOL="OnNavBack" />
                <node
                  class="auitool"
                  bitmap="Art;wxART_GO_FORWARD|wxART_TOOLBAR;[24,24]"
                  class_access="protected:"
                  initial_state="wxAUI_BUTTON_STATE_DISABLED"
                  label=""
                  var_name="m_forward"
                  wxEVT_TOOL="OnNavForward" />
                <node
                  class="auitool"
                  bitmap="Art;wxART_FIND|wxART_TOOLBAR;[30,30]"
                  label=""
                  var_name="find"
                  wxEVT_TOOL="OnFind" />
              </node>
              <node
                class="wxHtmlWindow"
                var_name="m_html_win"
                minimum_size="300,450"
                window_style="wxBORDER_SUNKEN"
                flags="wxEXPAND"
                proportion="1"
                wxEVT_HTML_LINK_CLICKED="OnHtmlLink" />
            </node>
          </node>
        </node>
      </node>
    </node>
    <node
      class="wxFrame"
      class_name="DocViewFrame_base"
      persist="1"
      title="wxWidgets Documentation"
      base_file="doc_view_frame_base"
      derived_class_name="DocViewFrame"
      pure_virtual_functions="1"
      minimum_size="300,600"
      wxEVT_CLOSE_WINDOW="OnClose">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL">
        <node
          class="wxPanel"
          class_access="protected:"
          var_name="m_DocViewPanel"
          subclass="DocViewPanel"
          subclass_header="../helptext/doc_view_panel.h"
          window_style="wxTAB_TRAVERSAL"
          border_size="0"
          borders=""
          flags="wxEXPAND"
          proportion="1"
          scale_border_size="0" />
      </node>
      <node
        class="wxToolBar">
        <node
          class="tool"
          bitmap="Art;wxART_FILE_OPEN|wxART_TOOLBAR;[24,24]"
          label=""
          wxEVT_TOOL="OnHome" />
        <node
          class="tool"
          bitmap="Art;wxART_INFORMATION|wxART_TOOLBAR;[30,30]"
          label=""
          var_name="tool_debug"
          wxEVT_TOOL="OnInfo" />
      </node>
      <node
        class="wxMenuBar">
        <node
          class="wxMenu"
          label="&amp;File"
          var_name="m_file_menu">
          <node
            class="wxMenuItem"
            bitmap="Art;wxART_FILE_OPEN|wxART_MENU"
            help="Open an existing document"
            id="wxID_OPEN"
            label="&amp;Open..."
            stock_id="wxID_OPEN"
            wxEVT_MENU="OnOpenArchive" />
          <node
            class="separator" />
          <node
            class="wxMenuItem"
            bitmap="Art;wxART_QUIT|wxART_MENU"
            help="Quit this program"
            id="wxID_EXIT"
            label="&amp;Quit"
            stock_id="wxID_EXIT"
            var_name="menu_item2" />
        </node>
      </node>
      <node
        class="wxStatusBar" />
    </node>
    <node
      class="wxDialog"
      class_name="HtmlFindDlgBase"
      title="Find in page"
      base_file="html_find_dlg_base"
      derived_class_name="HtmlFindDlg"
      derived_file="../helptext/html_find_dlg.cpp"
      wxEVT_INIT_DIALOG="OnInit">
      <node
        class="wxBoxSizer"
        orientation="wxVERTICAL"
        var_name="m_topSizer">
        <node
          class="wxTextCtrl"
          style="wxTE_PROCESS_ENTER"
          var_name="m_findTextCtrl"
          size="200,-1"
          flags="wxEXPAND"
          wxEVT_TEXT_ENTER="OnFindTextEnter"
          wxEVT_TEXT="OnText" />
        <node
          class="wxBoxSizer"
          var_name="m_btnSizer"
          alignment="wxALIGN_RIGHT"
          border_size="8"
          borders="wxBOTTOM">
          <node
            class="wxButton"
            default="1"
            label="&amp;Find Next"
            var_name="m_findNextBtn"
            id="wxID_FORWARD"
            wxEVT_BUTTON="OnFindNext" />
          <node
            class="wxButton"
            label=""
            var_name="m_cancelBtn"
            id="wxID_CANCEL" />
        </node>
      </node>
    </node>
  </node>
</wxUiEditorData>
