@echo off
rem ============================================================================
rem Regenerates the conformance kit from the generator library and sweeps it
rem across all six languages with `kwxgen check-ui`.
rem
rem Writes only:
rem     <quick>\tests\conformance\*.wxui and kit.json  (regenerated, never hand-edited)
rem     .private\kwxConformance.md                     (the sweep report)
rem     .private\kwx_conformance_data\ir\*.json        (per-form IR, for inspection)
rem
rem The kit is generated by `wxUiEditor --gen_conformance`: the class list, each
rem class's parent chain and each class's properties come from the compiled
rem generator library. No form is hand-authored.
rem
rem Exit codes: 0 sweep completed (gaps are data), 2 kit generation/load defect,
rem             1 usage or environment error.
rem
rem Usage (from the repository root):
rem     scripts\conformance.cmd
rem ============================================================================

setlocal

pushd "%~dp0.." || exit /b 1

pwsh -NoProfile -ExecutionPolicy Bypass -File "%~dp0conformance.ps1" %*
set "exit_code=%errorlevel%"

popd
exit /b %exit_code%
